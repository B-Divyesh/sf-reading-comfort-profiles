{
  "name": "reading-comfort-profiles",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "build:extension": "wxt build",
    "build:site": "wxt build && node scripts/package-extension.mjs && vite build --config vite.site.config.ts && node scripts/finalize-site.mjs",
    "build": "npm run build:site",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "verify": "npm run lint && npm run check && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.1.4",
    "@types/node": "^24.3.0",
    "fflate": "0.8.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
